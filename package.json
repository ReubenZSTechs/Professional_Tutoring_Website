{
  "name": "reuben-susanto-tutoring",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": ".venv/bin/python -m uvicorn agent.main:app --app-dir backend/src --reload --reload-dir backend/src --port 8000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "ingest": ".venv/bin/python backend/scripts/ingest.py",
    "test:api": ".venv/bin/python -m pytest backend/tests/unit -q"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
