# Copy this file to .env and fill in the values.
# On Vercel, add the same names under Project Settings > Environment Variables.
# Never commit .env: it holds secrets.

# --- Google Gemini (https://aistudio.google.com/apikey) -----------------
GEMINI_API_KEY=
# Optional model overrides. The defaults are set in backend/src/core/config.py.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Supabase (Project Settings > API) ----------------------------------
SUPABASE_URL=
# The secret / service-role key. Server only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form email (https://resend.com/api-keys) -------------------
RESEND_API_KEY=
# Where enquiries are sent. Without a verified domain, Resend only delivers
# to the address that owns the Resend account, so sign up with this address.
CONTACT_TO_EMAIL=reuben.zachary.rz@gmail.com
# CONTACT_FROM_EMAIL=Tutoring Website <onboarding@resend.dev>

# --- Site ----------------------------------------------------------------
# Public address of the site, used for link previews and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of sites allowed to call the API, or * for any.
ALLOWED_ORIGINS=*

# --- Optional -------------------------------------------------------------
# Save chat questions and answers to the Supabase chat_messages table.
# CHAT_LOGGING=false
# RATE_LIMIT_CHAT_PER_MIN=12
# RATE_LIMIT_CONTACT_PER_HOUR=5
# Send /api/* to a backend hosted somewhere other than Vercel.
# BACKEND_URL=
