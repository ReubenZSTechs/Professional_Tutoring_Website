# Copy this file to .env and fill in the values.
# On Vercel, add the same names under Project Settings > Environment Variables
# (see docs/deployment.md for which scope each one needs).
# Never commit .env: it holds secrets.

# --- Where the API is running ------------------------------------------------
# "development" on your machine, "production" on Vercel. In production the API
# refuses to start if a secret below is missing, hides /api/docs and returns
# generic error messages.
ENVIRONMENT=development

# --- Google Gemini (https://aistudio.google.com/apikey) ------------------
GEMINI_API_KEY=
# Optional model overrides. The defaults are set in backend/src/core/config.py.
# GEMINI_CHAT_MODEL=gemini-3.6-flash
# GEMINI_REWRITE_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBED_MODEL=gemini-embedding-2

# --- Supabase (Project Settings > API Keys) --------------------------------
SUPABASE_URL=
# The secret (service-role) key. Server only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Contact form email (https://resend.com/api-keys) ----------------------
RESEND_API_KEY=
# Where enquiries are sent. Without a verified domain, Resend only delivers
# to the address that owns the Resend account, so sign up with this address.
CONTACT_TO_EMAIL=reuben.zachary.rz@gmail.com
# CONTACT_FROM_EMAIL=Tutoring Website <onboarding@resend.dev>

# --- Site ---------------------------------------------------------------------
# Public address of the site. Used for link previews, the sitemap, and as the
# only origin allowed to call the API.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: extra origins allowed to call the API, comma-separated. Leave empty
# to allow only NEXT_PUBLIC_SITE_URL (plus localhost in development). "*" is not accepted.
ALLOWED_ORIGINS=

# --- Bot check: Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ----
# Create a widget for your site's hostname. The site key is public; the secret is not.
# In development the published test keys are used automatically, so these can stay empty locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secrets the API generates its own tokens with --------------------------
# Make each one with:  openssl rand -hex 32
# Salt for hashing visitor IP addresses before they are stored (rate limits, security log).
IP_HASH_SALT=
# Signs chat session tokens and chat transcripts. Changing it logs every visitor out of the chat.
CHAT_SIGNING_SECRET=

# --- Optional limits (defaults in backend/src/core/config.py) ---------------
# RATE_LIMIT_CHAT_PER_MIN=12
# RATE_LIMIT_CHAT_PER_DAY=150
# RATE_LIMIT_CONTACT_PER_HOUR=5
# Site-wide cap on chat requests per day: a circuit breaker on the Gemini bill.
# DAILY_CHAT_LIMIT=2000
# Save chat questions and answers to the Supabase chat_messages table.
# CHAT_LOGGING=false
# Send /api/* to a backend hosted somewhere other than Vercel.
# BACKEND_URL=
